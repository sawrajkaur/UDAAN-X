# Supabase: create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=sb_publishable_FrgddM5aUS6rNAsbbQwl5Q_2t8l_ee6
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never expose the service role key to browser code. Not required for normal user flows.
SUPABASE_SERVICE_ROLE_KEY=

# AI primary provider. Must expose an OpenAI-compatible /chat/completions endpoint.
AI_PRIMARY_BASE_URL=https://api.openai.com/v1
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=

# Optional AI fallback provider. Must also expose an OpenAI-compatible /chat/completions endpoint.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Legacy single-provider compatibility (used if primary/fallback are not configured).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments are disabled in this starter. Do not enable until provider approval,
# signed webhook verification, tax/legal review and production security testing are complete.
PAYMENTS_ENABLED=false

# Web Research (Tavily)
TAVILY_API_KEY=
